{
  "name": "soc-alert-triage",
  "version": "0.1.0",
  "private": true,
  "description": "SOC Alert Triage — code-mode parallel threat intel enrichment for security operations",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "bun test src/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "setup:n8n": "bash scripts/init-n8n.sh",
    "check-secrets": "bash scripts/check-secrets.sh",
    "check-secrets:staged": "bash scripts/check-secrets.sh --staged",
    "check-secrets:strict": "bash scripts/check-secrets.sh --strict",
    "new-workflow": "bash scripts/new-workflow.sh",
    "validate": "jq . workflow/workflow.json > /dev/null && echo 'Workflow JSON is valid'",
    "validate:workflows": "bash scripts/validate-workflows.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260714.1",
    "@types/bun": "^1.3.14",
    "n8nac": "^1.6.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.110.0"
  },
  "dependencies": {
    "hono": "^4.12.30"
  }
}
